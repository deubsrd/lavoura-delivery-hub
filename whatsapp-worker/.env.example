# URL do projeto Supabase (a mesma do app principal — ver .env na raiz do
# repo, variável SUPABASE_URL).
SUPABASE_URL=

# Service role key do MESMO projeto Supabase (Painel do Supabase > Project
# Settings > API > service_role secret). NUNCA a chave publicável/anon —
# essa aqui ignora RLS de propósito, porque o script escreve em
# whatsapp_mensagens/whatsapp_conexoes de todas as unidades e faz upload
# pro Storage. Trate esse valor como senha de root do banco: não commite,
# não logue, não exponha.
SUPABASE_SERVICE_ROLE_KEY=

# Pasta local onde as credenciais de sessão de cada unidade ficam salvas
# (uma subpasta por unidade_id). Padrão: ./sessions ao lado deste arquivo.
SESSIONS_DIR=./sessions
