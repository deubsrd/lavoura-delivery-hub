# Supabase — publishable/anon keys, safe to expose to the browser.
# These 6 values live in the actual (committed) .env file, not just here:
# Lovable Cloud's Secrets panel explicitly refuses SUPABASE_*-prefixed
# names (reserved, auto-managed internally) AND VITE_*-prefixed names
# ("build-time browser values should be defined in .env files, not in
# secrets") — so this is the only place the Vite client build can pick
# them up from. Do not move these into Lovable's Secrets panel; it will
# reject them, and the client bundle will ship without a working
# Supabase connection (see the "Missing Supabase environment variable(s)"
# incident in project history).
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Supabase service role key — do NOT set this yourself, here or in
# Secrets. Lovable Cloud reserves the SUPABASE_ name prefix and manages
# this automatically once the project is connected to Supabase.
# SUPABASE_SERVICE_ROLE_KEY=

# Password that gates the /admin-convites page (lists each unidade's
# invite code so it can be handed out to atendentes manually).
ADMIN_SECRET=

# Delivery-leg distance is calculated for free via OpenStreetMap
# (Nominatim geocoding + Haversine distance, see src/lib/geolocalizacao.server.ts)
# — no API key needed here.

# Webhook URL called whenever a pedido's status changes to recebido,
# pronto or entregue (POSTs phone/name/status). If unset, no notification
# is attempted and this is not treated as an error.
WHATSAPP_WEBHOOK_URL=
