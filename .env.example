# Supabase — client & server (public keys, safe to expose to the browser)
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Supabase — server only, NEVER expose to the client bundle. Used by
# src/integrations/supabase/client.server.ts to bypass RLS for trusted
# server-side operations (creating orders, admin lookups, etc).
SUPABASE_SERVICE_ROLE_KEY=

# Password that gates the /admin-convites page (lists each unidade's
# invite code so it can be handed out to atendentes manually).
ADMIN_SECRET=

# Google Maps Distance Matrix API key, used to price the delivery leg of
# an order by real driving distance. If unset, the order form still works
# but shows a friendly "couldn't calculate delivery distance" message.
GOOGLE_MAPS_API_KEY=

# Webhook URL called whenever a pedido's status changes to recebido,
# pronto or entregue (POSTs phone/name/status). If unset, no notification
# is attempted and this is not treated as an error.
WHATSAPP_WEBHOOK_URL=
